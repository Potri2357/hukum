# ==========================================================
# Hukum — environment template
# Copy to .env via `pnpm setup:env` (never commit .env)
# Every CHANGE_ME_* value is replaced with a random secret.
# ==========================================================

# --- Application ---
NODE_ENV=development
APP_NAME=Hukum
APP_ENV=local
PORT_API=4000
PORT_WEB=3000
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
SEED_ADMIN_EMAIL=admin@hukum.local
SEED_ADMIN_PASSWORD=CHANGE_ME_SEED_ADMIN_PASSWORD
SEED_DATA_SIZE=small

# --- MongoDB (lite = logical simulator, cluster = real sharded cluster) ---
MONGO_SHARDING_MODE=lite
MONGO_ROOT_USER=hukum_root
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_ROOT_PASSWORD
MONGO_DB_NAME=hukum
MONGO_URI=mongodb://hukum_root:CHANGE_ME_MONGO_ROOT_PASSWORD@localhost:27017/hukum?authSource=admin
MONGO_KEYFILE_PATH=./infra/mongo-sharding/keyfile
MONGO_READ_PREFERENCE=secondaryPreferred
MONGO_WRITE_CONCERN=majority

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379
REDIS_MAXMEMORY=256mb
REDIS_EVICTION_POLICY=allkeys-lru
REDIS_RING_NODES=localhost:6379,localhost:6380,localhost:6381

# --- Auth & security ---
JWT_ACCESS_SECRET=CHANGE_ME_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECRET=CHANGE_ME_COOKIE_SECRET
COOKIE_DOMAIN=localhost
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OTP, email, push (all local / simulated, no paid providers) ---
OTP_DELIVERY=console
OTP_LENGTH=6
OTP_TTL_SECONDS=300
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hukum <no-reply@hukum.local>"
MAILPIT_UI_PORT=8025
VAPID_PUBLIC_KEY=GENERATED_BY_SETUP_SCRIPT
VAPID_PRIVATE_KEY=GENERATED_BY_SETUP_SCRIPT
VAPID_SUBJECT=mailto:admin@hukum.local

# --- Payment Simulator (no real gateway; PAYMENT_MODE must stay "simulation") ---
PAYMENT_MODE=simulation
PAYMENT_SIM_WEBHOOK_SECRET=CHANGE_ME_PAYMENT_SIM_WEBHOOK_SECRET
PAYMENT_SIM_LATENCY_MS=800
PAYMENT_SIM_DEFAULT_OUTCOME=auto
PAYMENT_SIM_WEBHOOK_DELAY_MS=2000
PAYMENT_SIM_WEBHOOK_DUPLICATE_RATE=0.1
PAYMENT_SIM_WEBHOOK_REORDER=false
INVENTORY_RESERVATION_TTL_SECONDS=600
COD_MAX_AMOUNT=50000

# --- Object storage (MinIO, local) ---
STORAGE_DRIVER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=hukum_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_BUCKET=hukum-media

# --- URL shortener & cache (Modules 1-2) ---
SHORT_BASE_URL=http://localhost:8080
HASH_SALT=CHANGE_ME_HASH_SALT
SHORT_CODE_LENGTH=7
SHORT_HASH_ALGO=sha256
SHORT_MAX_COLLISION_RETRIES=5
CACHE_ENABLED=true
LINK_CACHE_TTL_SECONDS=86400
LINK_CACHE_JITTER_PCT=10
LINK_NEG_CACHE_TTL_SECONDS=60
CLICK_FLUSH_INTERVAL_MS=5000

# --- Rate limiter (Module 5) ---
RL_ENABLED=true
RL_FAIL_MODE_DEFAULT=open
RL_TRUST_PROXY=true
RL_PENALTY_ESCALATION=true

# --- Autocomplete (Module 6) ---
AC_TOP_K=10
AC_REBUILD_CRON=0 3 * * *
AC_INCREMENTAL_INTERVAL_SECONDS=60
AC_MIN_FREQUENCY=3

# --- Consistent hashing & lab (Modules 3-4) ---
RING_VNODES=150
RING_REPLICAS=2
RING_HASH=murmur3
LAB_DEFAULT_NODES=5

# --- Web crawler (Module 7) ---
CRAWLER_USER_AGENT=HukumBot/1.0 (+http://localhost:3000/bot)
CRAWLER_ALLOWLIST=mock-seller-site,localhost,127.0.0.1
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_PER_HOST_RPS=1
CRAWLER_MAX_CONCURRENCY=10
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES=500
CRAWLER_FETCH_TIMEOUT_MS=10000
CRAWLER_MAX_BYTES=2097152
CRAWLER_PLAYWRIGHT_ENABLED=false
MOCK_SELLER_SITE_URL=http://localhost:5050

# --- Observability ---
METRICS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# --- Web (browser-visible; NEVER put secrets here) ---
NEXT_PUBLIC_APP_NAME=Hukum
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SHORT_BASE_URL=http://localhost:8080
NEXT_PUBLIC_VAPID_PUBLIC_KEY=GENERATED_BY_SETUP_SCRIPT
NEXT_PUBLIC_AC_DEBOUNCE_MS=100
NEXT_PUBLIC_PAYMENT_SIM_BADGE=true
