NODE_ENV=test
APP_NAME=HukumTest
APP_ENV=test
PORT_API=4001
PORT_WEB=3001
WEB_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:4001
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=warn
SEED_ADMIN_EMAIL=admin@hukum.test
SEED_ADMIN_PASSWORD=test_admin_password_12345
SEED_DATA_SIZE=small

MONGO_SHARDING_MODE=lite
MONGO_ROOT_USER=hukum_root
MONGO_ROOT_PASSWORD=test_password
MONGO_DB_NAME=hukum_test
MONGO_URI=mongodb://localhost:27017/hukum_test
MONGO_KEYFILE_PATH=./infra/mongo-sharding/keyfile
MONGO_READ_PREFERENCE=secondaryPreferred
MONGO_WRITE_CONCERN=majority

REDIS_PASSWORD=test_redis_password
REDIS_URL=redis://localhost:6379
REDIS_MAXMEMORY=64mb
REDIS_EVICTION_POLICY=allkeys-lru
REDIS_RING_NODES=localhost:6379

JWT_ACCESS_SECRET=test_jwt_access_secret_deterministic_12345
JWT_REFRESH_SECRET=test_jwt_refresh_secret_deterministic_12345
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECRET=test_cookie_secret_12345
COOKIE_DOMAIN=localhost
GOOGLE_OAUTH_ENABLED=false

OTP_DELIVERY=console
OTP_LENGTH=6
OTP_TTL_SECONDS=300
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hukum <no-reply@hukum.test>"
MAILPIT_UI_PORT=8025
VAPID_PUBLIC_KEY=test_vapid_public_key
VAPID_PRIVATE_KEY=test_vapid_private_key
VAPID_SUBJECT=mailto:admin@hukum.test

PAYMENT_MODE=simulation
PAYMENT_SIM_WEBHOOK_SECRET=test_payment_sim_webhook_secret_12345
PAYMENT_SIM_LATENCY_MS=50
PAYMENT_SIM_DEFAULT_OUTCOME=auto
PAYMENT_SIM_WEBHOOK_DELAY_MS=0
PAYMENT_SIM_WEBHOOK_DUPLICATE_RATE=0
PAYMENT_SIM_WEBHOOK_REORDER=false
INVENTORY_RESERVATION_TTL_SECONDS=60
COD_MAX_AMOUNT=50000

STORAGE_DRIVER=local
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=hukum_minio
MINIO_ROOT_PASSWORD=test_minio_password
MINIO_BUCKET=hukum-media

SHORT_BASE_URL=http://localhost:8080
HASH_SALT=test_hash_salt_12345
SHORT_CODE_LENGTH=7
SHORT_HASH_ALGO=sha256
SHORT_MAX_COLLISION_RETRIES=5
CACHE_ENABLED=true
LINK_CACHE_TTL_SECONDS=3600
LINK_CACHE_JITTER_PCT=0
LINK_NEG_CACHE_TTL_SECONDS=10
CLICK_FLUSH_INTERVAL_MS=1000

RL_ENABLED=true
RL_FAIL_MODE_DEFAULT=open
RL_TRUST_PROXY=true
RL_PENALTY_ESCALATION=false

AC_TOP_K=10
AC_REBUILD_CRON="0 3 * * *"
AC_INCREMENTAL_INTERVAL_SECONDS=60
AC_MIN_FREQUENCY=1

RING_VNODES=150
RING_REPLICAS=2
RING_HASH=murmur3
LAB_DEFAULT_NODES=5

CRAWLER_USER_AGENT=HukumBot/1.0 (+http://localhost:3000/bot)
CRAWLER_ALLOWLIST=mock-seller-site,localhost,127.0.0.1
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_PER_HOST_RPS=10
CRAWLER_MAX_CONCURRENCY=2
CRAWLER_MAX_DEPTH=2
CRAWLER_MAX_PAGES=20
CRAWLER_FETCH_TIMEOUT_MS=2000
CRAWLER_MAX_BYTES=1048576
CRAWLER_PLAYWRIGHT_ENABLED=false
MOCK_SELLER_SITE_URL=http://localhost:5050

METRICS_ENABLED=false
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

NEXT_PUBLIC_APP_NAME=HukumTest
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001
NEXT_PUBLIC_SHORT_BASE_URL=http://localhost:8080
NEXT_PUBLIC_VAPID_PUBLIC_KEY=test_vapid_public_key
NEXT_PUBLIC_AC_DEBOUNCE_MS=10
NEXT_PUBLIC_PAYMENT_SIM_BADGE=true
